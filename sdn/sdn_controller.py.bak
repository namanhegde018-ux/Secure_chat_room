import json
import urllib.request
import urllib.error

from os_ken.base import app_manager
from os_ken.controller import ofp_event
from os_ken.controller.handler import (
    CONFIG_DISPATCHER,
    MAIN_DISPATCHER,
    set_ev_cls
)
from os_ken.ofproto import ofproto_v1_3
from os_ken.lib.packet import (
    packet,
    ethernet,
    ether_types,
    ipv4,
    ipv6,
    arp
)

import ipaddress

MALLORY_PORT = 4
MALLORY_MAC = "00:00:00:00:00:03"

FLASK_EVENT_URL = "http://127.0.0.1:5000/internal/event"

HOSTS = {
    "10.0.0.1": "Alice",
    "10.0.0.2": "Bob",
    "10.0.0.3": "Server",
    "10.0.0.4": "Mallory"
}


class SecureMessagingController(app_manager.OSKenApp):

    OFP_VERSIONS = [ofproto_v1_3.OFP_VERSION]

    def __init__(self, *args, **kwargs):

        super().__init__(*args, **kwargs)
        print(
            "[LOAD] SecureMessagingController instantiated",
            flush=True
	)
        self.logger.info(
            "Secure Messaging Controller Started"
        )

    # ======================================
    # INSTALL FLOW RULE
    # ======================================

    def add_flow(self, datapath, priority, match, actions):

        parser = datapath.ofproto_parser
        ofproto = datapath.ofproto

        instructions = [
            parser.OFPInstructionActions(
                ofproto.OFPIT_APPLY_ACTIONS,
                actions
            )
        ]

        mod = parser.OFPFlowMod(
            datapath=datapath,
            priority=priority,
            match=match,
            instructions=instructions
        )

        datapath.send_msg(mod)

    # ======================================
    # SEND EVENT TO FLASK
    # ======================================

    def send_dashboard_event(
        self,
        source,
        destination,
        message
    ):

        data = {
            "source": source,
            "destination": destination,
            "status": "BLOCKED",
            "message": message
        }

        try:

            payload = json.dumps(data).encode("utf-8")

            req = urllib.request.Request(
                FLASK_EVENT_URL,
                data=payload,
                headers={
                    "Content-Type": "application/json"
                },
                method="POST"
            )

            with urllib.request.urlopen(
                req,
                timeout=1
            ) as response:

                self.logger.info(
                    "Dashboard event delivered: %s -> %s",
                    source,
                    destination
                )

        except Exception as error:

            self.logger.warning(
                "Could not send dashboard event: %s",
                error
            )

    # ======================================
    # IDENTIFY SOURCE AND DESTINATION
    # ======================================

def identify_hosts(self, pkt, eth, in_port):

    ip4_header = pkt.get_protocol(ipv4.ipv4)
    ip6_header = pkt.get_protocol(ipv6.ipv6)
    arp_header = pkt.get_protocol(arp.arp)

    source_ip = None
    destination_ip = None

    if ip4_header:

        source_ip = ip4_header.src
        destination_ip = ip4_header.dst

    elif ip6_header:

        source_ip = ip6_header.src
        destination_ip = ip6_header.dst

    elif arp_header:

        source_ip = arp_header.src_ip
        destination_ip = arp_header.dst_ip

    # Identify source device

    if (
        in_port == MALLORY_PORT
        or eth.src.lower() == MALLORY_MAC
    ):

        source = "Mallory"

    else:

        source = HOSTS.get(source_ip, source_ip or eth.src)

    # Identify destination device

    if eth.dst.lower() == MALLORY_MAC:

        destination = "Mallory"

    elif destination_ip in HOSTS:

        destination = HOSTS[destination_ip]

    elif destination_ip:

        try:

            address = ipaddress.ip_address(destination_ip)

            if address.is_multicast:

                destination = "IPv6 multicast"

            else:

                destination = destination_ip

        except ValueError:

            destination = destination_ip

    elif eth.dst.lower() == "ff:ff:ff:ff:ff:ff":

        destination = "Broadcast"

    elif eth.dst.lower().startswith("33:33:"):

        destination = "IPv6 multicast"

    else:

        destination = eth.dst

    return source, destination

    # ======================================
    # SWITCH CONNECTION
    # ======================================

    @set_ev_cls(
        ofp_event.EventOFPSwitchFeatures,
        CONFIG_DISPATCHER
    )
    def switch_features_handler(self, ev):
	print(
            "[EVENT] SwitchFeatures received!",
    	    flush=True
        )
        datapath = ev.msg.datapath

        print(
            f"[DEBUG] SWITCH FEATURES EVENT RECEIVED: DPID={datapath.id}",
            flush=True
        )
        parser = datapath.ofproto_parser
        ofproto = datapath.ofproto

        # Remove previous flow rules
        delete = parser.OFPFlowMod(
            datapath=datapath,
            command=ofproto.OFPFC_DELETE,
            table_id=ofproto.OFPTT_ALL,
            out_port=ofproto.OFPP_ANY,
            out_group=ofproto.OFPG_ANY,
            match=parser.OFPMatch()
        )

        datapath.send_msg(delete)

        print("[DEBUG] Previous flow rules deleted", flush=True)

        # Default rule: send unknown packets to controller

        self.add_flow(
            datapath,
            priority=0,
            match=parser.OFPMatch(),
            actions=[
                parser.OFPActionOutput(
                    ofproto.OFPP_CONTROLLER,
                    ofproto.OFPCML_NO_BUFFER
                )
            ]
        )

        # Send Mallory's incoming traffic to controller.
        # There is NO forwarding action to another host.

        monitor_action = [
            parser.OFPActionOutput(
                ofproto.OFPP_CONTROLLER,
                ofproto.OFPCML_NO_BUFFER
            )
        ]

        self.add_flow(
            datapath,
            priority=500,
            match=parser.OFPMatch(
                in_port=MALLORY_PORT
            ),
            actions=monitor_action
        )

        # Also monitor traffic destined for Mallory

        self.add_flow(
            datapath,
            priority=500,
            match=parser.OFPMatch(
                eth_dst=MALLORY_MAC
            ),
            actions=monitor_action
        )

        # Controlled ARP discovery

        arp_paths = {
            1: [2, 3],
            2: [1, 3],
            3: [1, 2]
        }

        for in_port, output_ports in arp_paths.items():

            arp_actions = [
                parser.OFPActionOutput(port)
                for port in output_ports
            ]

            self.add_flow(
                datapath,
                priority=300,
                match=parser.OFPMatch(
                    in_port=in_port,
                    eth_type=0x0806
                ),
                actions=arp_actions
            )

        self.logger.info(
            "Switch connected. Security rules installed."
        )

        self.logger.info(
            "Mallory monitoring enabled."
        )
    print("[SUCCESS] All security rules submitted to switch", flush=True)
# ======================================
# HANDLE OPENFLOW ERRORS
# ======================================

    @set_ev_cls(
        ofp_event.EventOFPErrorMsg,
        [CONFIG_DISPATCHER, MAIN_DISPATCHER]
    )
    def error_handler(self, ev):

        msg = ev.msg

        print(
            "[OPENFLOW ERROR]",
            "Type:", msg.type,
            "Code:", msg.code,
            flush=True
        )

        self.logger.error(
            "OpenFlow error received: type=%s code=%s",
            msg.type,
            msg.code
        )
    # ======================================
    # HANDLE INCOMING PACKETS
    # ======================================

    @set_ev_cls(
        ofp_event.EventOFPPacketIn,
        MAIN_DISPATCHER
    )
    def packet_in_handler(self, ev):

        msg = ev.msg

        in_port = msg.match["in_port"]

        pkt = packet.Packet(msg.data)

        eth = pkt.get_protocol(
            ethernet.ethernet
        )

        if eth is None:
            return

        if eth.ethertype == ether_types.ETH_TYPE_LLDP:
            return

        # Identify Mallory-related traffic

        is_mallory = (
            in_port == MALLORY_PORT
            or eth.src.lower() == MALLORY_MAC
            or eth.dst.lower() == MALLORY_MAC
        )

        if is_mallory:

            source, destination = self.identify_hosts(
                pkt,
                eth,
                in_port
            )

            message = (
                f"Blocked by SDN security policy. "
                f"Switch ingress port: {in_port}"
            )

            self.logger.warning(
                "BLOCKED ATTEMPT: %s -> %s",
                source,
                destination
            )

            # Report the attempt to Flask

            self.send_dashboard_event(
                source,
                destination,
                message
            )

            # IMPORTANT:
            # Do not forward the packet.
            return

        # Other unmatched traffic is also not forwarded.
        self.logger.info(
            "Unauthorised traffic dropped: port=%s",
            in_port
        )
